{
  "manifest_version": 3,
  "name": "YouTube SamurAI",
  "version": "0.1.0",
  "description": "Youtube AI Summary",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
