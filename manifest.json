{
  "manifest_version": 3,
  "name": "YouTube SamurAI",
  "version": "0.1.0",
  "description": "Youtube AI Summary",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["settings.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["settings.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["ninja-2.svg"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
